{
  "name": "inkloop",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"],
    "html_handling": "none",
  },
  "d1_databases": [{ "binding": "DB", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "r2_buckets": [{ "binding": "STORAGE" }],
  "durable_objects": { "bindings": [{ "name": "CHANGE_HUB", "class_name": "ChangeHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChangeHub"] }],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "10079002", "simple": { "limit": 60, "period": 60 } },
  ],
  "observability": { "enabled": false },
}
